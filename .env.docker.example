# Docker Compose variable overrides (used via --env-file .env.docker)
# This file controls compose substitution variables only.

# Host Ollama endpoint reachable from containers
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434

# Runtime behavior in containers
DOCKER_OFFLINE_MODE=false
DOCKER_REQUIRE_OLLAMA=true
DOCKER_REQUIRE_IMAGE_RETRIEVAL=true
DOCKER_REQUIRE_SEMANTIC_MODEL_CACHE=false

# Mounted artifact/cache paths inside backend container
DOCKER_YOLOGEN_DATA_ROOT=/mounted/vlm/data/processed
DOCKER_INDEX_PATH=/mounted/agentic-rag/data/faiss_index
DOCKER_HF_HOME=/mounted/agentic-rag/.cache/huggingface
DOCKER_SENTENCE_TRANSFORMERS_HOME=/mounted/agentic-rag/.cache/torch/sentence_transformers

# Optional absolute base URL for backend-generated image links
DOCKER_API_PUBLIC_BASE_URL=

# Internal Docker network API base URL for image URL validation
DOCKER_API_BASE_URL=http://backend:8000

# Optional preprocess profile overrides
DOCKER_VLM_OLLAMA_BASE_URL=http://host.docker.internal:11434
DOCKER_VLM_MODEL=llava:13b
