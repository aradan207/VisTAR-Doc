# LLM Configuration
OLLAMA_MODEL=hf.co/bartowski/mistralai_Ministral-3-8B-Instruct-2512-GGUF:Q4_K_M

# Dedicated judge model for RAGAS benchmarks
RAGAS_JUDGE_MODEL=hf.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF:Q4_K_M

# Embedding Model Configuration (for RAG)
OLLAMA_EMBED_MODEL=hf.co/ChristianAzinn/mxbai-embed-large-v1-gguf:Q4_K_M

# Runtime mode (strict local by default). Set to false to re-enable web tools.
OFFLINE_MODE=true

# In offline mode, block startup if image retrieval prerequisites are missing.
REQUIRE_IMAGE_RETRIEVAL=true

# In offline mode, require local sentence-transformers caches and avoid network fetch.
REQUIRE_SEMANTIC_MODEL_CACHE=true

# Require Ollama connectivity at startup (recommended true).
REQUIRE_OLLAMA=true

# Planner safety limits to avoid repetitive or runaway node generation.
MAX_TOTAL_NODES=80
MAX_CHILDREN_PER_LEAF=2
MAX_DEPTH=5

# Optional explicit path overrides for image artifacts.
# YOLOGEN_ROOT=C:/Users/you/Repositories/vlm-yolo-detector
# YOLOGEN_DATA_ROOT=C:/Users/you/Repositories/vlm-yolo-detector/data/processed

# Optional cache roots for sentence-transformers artifacts.
# For native/local runs, repo-relative cache roots are recommended.
# HF_HOME=./.cache/huggingface
# SENTENCE_TRANSFORMERS_HOME=./.cache/torch/sentence_transformers

# RAG Configuration
MANUALS_PATH=data/manuals
INDEX_PATH=data/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Ollama Server (optional, defaults to localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Docker notes:
# - If backend runs in Docker and Ollama runs on host Windows, use:
#   OLLAMA_HOST=http://host.docker.internal:11434
# - If you need absolute image URLs in API output (optional), set:
#   API_PUBLIC_BASE_URL=http://<host-or-lan-ip>:8000
